# Use the exact public HTTPS origin (without trailing slash).
APP_ORIGIN=https://your-domain.example
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Google sign-in for /studio. Create an OAuth 2.0 "Web application" client in
# Google Cloud Console and add APP_ORIGIN + /api/auth/google/callback as an
# authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only Google Workspace accounts on this domain may sign in.
GOOGLE_ALLOWED_DOMAIN=marketingtusk.com
# Optional: narrow access further to specific addresses (comma separated).
# GOOGLE_ALLOWED_EMAILS=you@marketingtusk.com
# Generate on your own device; NEVER commit real values.
ADMIN_SESSION_SECRET=
INTAKE_ENCRYPTION_KEY=
# Keep staging noindex; set to public only after review.
SEO_INDEXING=private
SITE_ACCESS_MODE=owner-private
# SEO_PUBLIC_ORIGIN=https://healthcare.marketingtusk.com
# ANALYTICS_ENABLED=true
# GA4_MEASUREMENT_ID=
# CLARITY_PROJECT_ID=
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
